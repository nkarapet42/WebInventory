@using System.Text.Json
@using WebInventory.Application.Constants
@using WebInventory.Domain.Enums
@model InventoryFieldsViewModel

@{
    ViewData["Title"] = $"Fields - {Model.InventoryTitle}";
    var fieldsJson = JsonSerializer.Serialize(Model.Fields.Select(field => new
    {
        id = field.Id,
        title = field.Title,
        description = field.Description,
        fieldType = field.FieldType.ToString(),
        fieldTypeValue = (int)field.FieldType,
        slotNumber = field.SlotNumber,
        showInTable = field.ShowInTable
    }));
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1>Fields</h1>
        <div class="text-muted">@Model.InventoryTitle</div>
    </div>
    <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.InventoryId">Back to Inventory</a>
</div>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}

<div class="row g-4">
    <div class="col-lg-5">
        <form asp-action="SaveField" asp-route-id="@Model.InventoryId" method="post">
            <input type="hidden" asp-for="InventoryId" />
            <input type="hidden" asp-for="InventoryTitle" />
            <input type="hidden" asp-for="Form.InventoryId" />
            <input type="hidden" asp-for="Form.Id" />

            <div class="mb-3">
                <label asp-for="Form.Title" class="form-label"></label>
                <input asp-for="Form.Title" class="form-control" />
                <span asp-validation-for="Form.Title" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Form.Description" class="form-label"></label>
                <textarea asp-for="Form.Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Form.Description" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-sm-7 mb-3">
                    <label asp-for="Form.FieldType" class="form-label">Type</label>
                    <select asp-for="Form.FieldType" class="form-select" asp-items="Html.GetEnumSelectList<InventoryFieldType>()"></select>
                    <span asp-validation-for="Form.FieldType" class="text-danger"></span>
                </div>
                <div class="col-sm-5 mb-3">
                    <label asp-for="Form.SlotNumber" class="form-label">Slot</label>
                    <select asp-for="Form.SlotNumber" class="form-select">
                        @for (var slot = 1; slot <= InventoryLimits.MaxFieldsPerType; slot++)
                        {
                            <option value="@slot">@slot</option>
                        }
                    </select>
                    <span asp-validation-for="Form.SlotNumber" class="text-danger"></span>
                </div>
            </div>

            <div class="form-check mb-3">
                <input asp-for="Form.ShowInTable" class="form-check-input" />
                <label asp-for="Form.ShowInTable" class="form-check-label">Show in item table</label>
            </div>

            <div class="d-flex gap-2">
                <button class="btn btn-primary" type="submit">Save Field</button>
                <a class="btn btn-outline-secondary" asp-action="Fields" asp-route-id="@Model.InventoryId">Clear</a>
            </div>
        </form>
    </div>

    <div class="col-lg-7">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h2 class="h4 mb-0">Configured Fields</h2>
            <span class="text-muted small">Drag rows to reorder</span>
        </div>
        <div class="btn-toolbar gap-2 mb-2" role="toolbar" aria-label="Field actions">
            <button class="btn btn-outline-secondary" id="edit-selected-field" type="button" disabled>Edit Selected</button>
            <form asp-action="DeleteField" asp-route-id="@Model.InventoryId" method="post" id="delete-selected-field-form" class="d-inline">
                <input type="hidden" name="fieldId" id="delete-selected-field-id" />
                <button class="btn btn-outline-danger" id="delete-selected-field" type="submit" disabled>Delete Selected</button>
            </form>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                <tr>
                    <th style="width: 2rem;"></th>
                    <th>Title</th>
                    <th>Type</th>
                    <th>Slot</th>
                    <th>Table</th>
                </tr>
                </thead>
                <tbody id="fields-sortable">
                @foreach (var field in Model.Fields)
                {
                    <tr data-field-id="@field.Id" tabindex="0">
                        <td class="text-muted field-drag-handle">::</td>
                        <td>
                            @field.Title
                            @if (!string.IsNullOrWhiteSpace(field.Description))
                            {
                                <div class="text-muted small">@field.Description</div>
                            }
                        </td>
                        <td>@field.FieldType</td>
                        <td>@field.SlotNumber</td>
                        <td>@(field.ShowInTable ? "Yes" : "No")</td>
                    </tr>
                }
                @if (!Model.Fields.Any())
                {
                    <tr>
                        <td colspan="5" class="text-muted">No custom fields configured.</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"></script>
    <script>
        const fields = @Html.Raw(fieldsJson);
        const inventoryId = '@Model.InventoryId';
        const editSelectedButton = document.getElementById('edit-selected-field');
        const deleteSelectedButton = document.getElementById('delete-selected-field');
        const deleteSelectedFieldId = document.getElementById('delete-selected-field-id');
        const sortableBody = document.getElementById('fields-sortable');
        let selectedFieldId = null;

        sortableBody?.querySelectorAll('tr[data-field-id]').forEach(row => {
            row.addEventListener('click', () => selectField(row.dataset.fieldId));
            row.addEventListener('keydown', event => {
                if (event.key === 'Enter' || event.key === ' ') {
                    event.preventDefault();
                    selectField(row.dataset.fieldId);
                }
            });
            row.addEventListener('dblclick', () => editSelectedField());
        });

        editSelectedButton?.addEventListener('click', () => editSelectedField());

        document.getElementById('delete-selected-field-form')?.addEventListener('submit', event => {
            if (!selectedFieldId || !confirm('Delete the selected field? Existing item values in this slot will stay in the database but the field will no longer be shown.')) {
                event.preventDefault();
            }
        });

        function selectField(fieldId) {
            selectedFieldId = fieldId;
            deleteSelectedFieldId.value = fieldId || '';
            editSelectedButton.disabled = !fieldId;
            deleteSelectedButton.disabled = !fieldId;

            sortableBody.querySelectorAll('tr[data-field-id]').forEach(row => {
                row.classList.toggle('table-active', row.dataset.fieldId === fieldId);
            });
        }

        function editSelectedField() {
            const field = fields.find(item => item.id === selectedFieldId);
                if (!field) {
                    return;
                }

                document.getElementById('Form_Id').value = field.id;
                document.getElementById('Form_Title').value = field.title;
                document.getElementById('Form_Description').value = field.description || '';
                document.getElementById('Form_FieldType').value = field.fieldTypeValue.toString();
                document.getElementById('Form_SlotNumber').value = field.slotNumber.toString();
                document.getElementById('Form_ShowInTable').checked = field.showInTable;
                document.getElementById('Form_Title').focus();
        }

        if (sortableBody && fields.length > 1) {
            new Sortable(sortableBody, {
                animation: 150,
                handle: '.field-drag-handle',
                onEnd: async () => {
                    const orderedFields = [...sortableBody.querySelectorAll('tr[data-field-id]')]
                        .map((row, index) => ({ id: row.dataset.fieldId, displayOrder: index + 1 }));

                    await fetch(`/Inventories/ReorderFields/${inventoryId}`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(orderedFields)
                    });
                }
            });
        }
    </script>
}
