@model WebInventory.Web.Models.SearchViewModel
@inject WebInventory.Web.Services.MarkdownService MarkdownService

<h1>@T["Search"]</h1>

<form method="get" class="mb-4">
    <div class="input-group">
        <input class="form-control" name="q" value="@Model.Query" placeholder="@T["Search inventories, items, tags"]" />
        <button class="btn btn-primary" type="submit">@T["Search"]</button>
    </div>
</form>

@if (!string.IsNullOrWhiteSpace(Model.Query))
{
    <h2>@T["Inventories"]</h2>
    <ul class="list-group mb-4">
        @foreach (var inventory in Model.Inventories)
        {
            <li class="list-group-item">
                <a asp-controller="Inventories" asp-action="Details" asp-route-id="@inventory.Id">@inventory.Title</a>
                @if (!string.IsNullOrWhiteSpace(inventory.DescriptionMarkdown))
                {
                    <div class="text-muted small markdown-preview">@Html.Raw(MarkdownService.ToHtml(inventory.DescriptionMarkdown))</div>
                }
            </li>
        }
        @if (!Model.Inventories.Any())
        {
            <li class="list-group-item">@T["No inventories found."]</li>
        }
    </ul>

    <h2>@T["Items"]</h2>
    <ul class="list-group mb-4">
        @foreach (var item in Model.Items)
        {
            <li class="list-group-item">
                @item.CustomId
            </li>
        }
        @if (!Model.Items.Any())
        {
            <li class="list-group-item">@T["No items found."]</li>
        }
    </ul>

    <h2>@T["Tags"]</h2>
    <ul class="list-group">
        @foreach (var tag in Model.Tags)
        {
            <li class="list-group-item">@tag.Name</li>
        }
        @if (!Model.Tags.Any())
        {
            <li class="list-group-item">@T["No tags found."]</li>
        }
    </ul>
}
