@model HomeIndexViewModel
@inject WebInventory.Web.Services.MarkdownService MarkdownService

@{
    ViewData["Title"] = "Home";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>@T["Inventory Management"]</h1>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a class="btn btn-primary" asp-controller="Inventories" asp-action="Create">@T["New Inventory"]</a>
    }
</div>

<section class="mb-5">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h2 class="h4 mb-0">@T["Latest Inventories"]</h2>
        <a asp-controller="Inventories" asp-action="Index">@T["View all"]</a>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
            <tr>
                <th>@T["Inventory"]</th>
                <th>@T["Category"]</th>
                <th>@T["Creator"]</th>
                <th class="text-end">@T["Items"]</th>
                <th>@T["Updated"]</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var inventory in Model.LatestInventories)
            {
                <tr>
                    <td>
                        <a asp-controller="Inventories" asp-action="Details" asp-route-id="@inventory.Id">@inventory.Title</a>
                        @if (!string.IsNullOrWhiteSpace(inventory.DescriptionMarkdown))
                        {
                            <div class="text-muted small markdown-preview" style="max-width: 38rem;">@Html.Raw(MarkdownService.ToHtml(inventory.DescriptionMarkdown))</div>
                        }
                    </td>
                    <td>@(inventory.CategoryName ?? T["Other"].Value)</td>
                    <td>@(inventory.CreatorName ?? T["Unknown"].Value)</td>
                    <td class="text-end">@inventory.ItemCount</td>
                    <td>@inventory.UpdatedAt.ToString("g")</td>
                </tr>
            }
            @if (!Model.LatestInventories.Any())
            {
                <tr>
                    <td colspan="5" class="text-muted">@T["No inventories yet."]</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>

<section class="mb-5">
    <h2 class="h4 mb-2">@T["Top 5 Popular Inventories"]</h2>
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
            <tr>
                <th>@T["Inventory"]</th>
                <th>@T["Creator"]</th>
                <th class="text-end">@T["Items"]</th>
                <th>@T["Updated"]</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var inventory in Model.PopularInventories)
            {
                <tr>
                    <td>
                        <a asp-controller="Inventories" asp-action="Details" asp-route-id="@inventory.Id">@inventory.Title</a>
                    </td>
                    <td>@(inventory.CreatorName ?? T["Unknown"].Value)</td>
                    <td class="text-end">@inventory.ItemCount</td>
                    <td>@inventory.UpdatedAt.ToString("g")</td>
                </tr>
            }
            @if (!Model.PopularInventories.Any())
            {
                <tr>
                    <td colspan="4" class="text-muted">@T["No inventory activity yet."]</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>

<section>
    <h2 class="h4 mb-2">@T["Tags"]</h2>
    @if (Model.TagCloud.Any())
    {
        <div class="d-flex flex-wrap gap-2">
            @foreach (var tag in Model.TagCloud)
            {
                <a class="tag-cloud-item tag-weight-@tag.Weight"
                   asp-controller="Search"
                   asp-action="Index"
                   asp-route-q="@tag.Name"
                   title="@tag.InventoryCount inventories">
                    @tag.Name
                </a>
            }
        </div>
    }
    else
    {
        <p class="text-muted">@T["No tags yet."]</p>
    }
</section>
