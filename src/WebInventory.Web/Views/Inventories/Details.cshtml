@using System.Security.Claims
@model WebInventory.Domain.Entities.Inventory

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>@Model.Title</h1>
    @if (User.Identity?.IsAuthenticated == true && User.FindFirstValue(ClaimTypes.NameIdentifier) == Model.OwnerId)
    {
        <div>
            <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
            <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@Model.Id">Delete</a>
        </div>
    }
</div>

<dl class="row">
    <dt class="col-sm-2">Category</dt>
    <dd class="col-sm-10">@Model.Category?.Name</dd>

    <dt class="col-sm-2">Description</dt>
    <dd class="col-sm-10">@Model.DescriptionMarkdown</dd>

    <dt class="col-sm-2">Access</dt>
    <dd class="col-sm-10">@Model.AccessMode</dd>

    <dt class="col-sm-2">Image</dt>
    <dd class="col-sm-10">@Model.ImageUrl</dd>

    <dt class="col-sm-2">Updated</dt>
    <dd class="col-sm-10">@Model.UpdatedAt.ToString("u")</dd>
</dl>

<a class="btn btn-link" asp-action="Index">Back to list</a>
