@model WebInventory.Web.Models.InventoryFormViewModel

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@yaireo/tagify/dist/tagify.css" />

<h1>Edit Inventory</h1>

@if (TempData["InventoryEditError"] is string editError)
{
    <div class="alert alert-danger" role="alert">@editError</div>
}

<form id="inventorySettingsForm" asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="RowVersion" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <div class="mb-3">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="DescriptionMarkdown" class="form-label"></label>
        <textarea asp-for="DescriptionMarkdown" class="form-control" rows="6"></textarea>
        <span asp-validation-for="DescriptionMarkdown" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="CategoryId" class="form-label"></label>
        <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.Categories">
            <option value="">Uncategorized</option>
        </select>
    </div>
    <div class="mb-3">
        <label asp-for="ImageUrl" class="form-label"></label>
        <input asp-for="ImageUrl" class="form-control" />
        <span asp-validation-for="ImageUrl" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Tags" class="form-label"></label>
        <input asp-for="Tags" class="form-control" autocomplete="off" />
        <span asp-validation-for="Tags" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="AccessMode" class="form-label"></label>
        <select asp-for="AccessMode" class="form-select" asp-items="Html.GetEnumSelectList<WebInventory.Domain.Enums.InventoryAccessMode>()"></select>
    </div>
    <div id="autosaveStatus" class="small text-muted mb-3" role="status">Autosave ready.</div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a class="btn btn-link" asp-action="Details" asp-route-id="@Model.Id">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/@@yaireo/tagify"></script>
    <script>
        (() => {
            const form = document.getElementById('inventorySettingsForm');
            const status = document.getElementById('autosaveStatus');
            const rowVersion = form.querySelector('[name="RowVersion"]');
            const token = form.querySelector('[name="__RequestVerificationToken"]');
            const tagInput = document.getElementById('Tags');
            const tagify = new Tagify(tagInput, {
                maxTags: 20,
                dropdown: {
                    enabled: 1,
                    maxItems: 10,
                    closeOnSelect: false
                }
            });
            let dirty = false;
            let saving = false;
            let blockedByConflict = false;

            tagify.on('input', async event => {
                const value = event.detail.value.trim();
                if (!value) {
                    return;
                }

                const response = await fetch(`/Inventories/TagSuggestions?q=${encodeURIComponent(value)}`);
                if (response.ok) {
                    tagify.whitelist = await response.json();
                    tagify.dropdown.show(value);
                }
            });

            form.addEventListener('input', () => {
                dirty = true;
                setStatus('Unsaved changes.', 'text-muted');
            });

            form.addEventListener('change', () => {
                dirty = true;
                setStatus('Unsaved changes.', 'text-muted');
            });

            form.addEventListener('submit', () => {
                dirty = false;
            });

            window.setInterval(async () => {
                if (!dirty || saving || blockedByConflict) {
                    return;
                }

                saving = true;
                setStatus('Autosaving...', 'text-muted');

                try {
                    const response = await fetch('@Url.Action("Autosave", "Inventories", new { id = Model.Id })', {
                        method: 'POST',
                        body: new FormData(form),
                        headers: {
                            'RequestVerificationToken': token.value,
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    });

                    if (response.ok) {
                        const result = await response.json();
                        rowVersion.value = result.rowVersion;
                        dirty = false;
                        setStatus(`Autosaved ${result.savedAt}.`, 'text-success');
                        return;
                    }

                    if (response.status === 409) {
                        const result = await response.json();
                        blockedByConflict = true;
                        setStatus(result.message || 'Autosave conflict. Refresh before continuing.', 'text-danger');
                        return;
                    }

                    setStatus('Autosave failed. Check the field values and try again.', 'text-danger');
                } catch {
                    setStatus('Autosave failed. Check your connection.', 'text-danger');
                } finally {
                    saving = false;
                }
            }, 8000);

            function setStatus(message, className) {
                status.className = `small mb-3 ${className}`;
                status.textContent = message;
            }
        })();
    </script>
}
