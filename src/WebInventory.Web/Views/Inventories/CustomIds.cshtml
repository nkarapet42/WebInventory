@model WebInventory.Web.Models.CustomIdPatternViewModel

<h1>Custom ID Pattern</h1>

<form asp-action="CustomIds" method="post">
    <input type="hidden" asp-for="InventoryId" />
    <div class="mb-3">
        <label asp-for="Pattern" class="form-label">Pattern</label>
        <select asp-for="Pattern" class="form-select" asp-items="ViewBag.PatternOptions"></select>
        <span asp-validation-for="Pattern" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label">Preview</label>
        <div class="form-control" readonly>@Model.Preview</div>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a class="btn btn-link" asp-action="Details" asp-route-id="@Model.InventoryId">Back</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
