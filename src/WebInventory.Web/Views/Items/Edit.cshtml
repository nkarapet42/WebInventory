@using WebInventory.Domain.Entities
@using WebInventory.Domain.Enums
@model WebInventory.Web.Models.ItemFormViewModel
@{
    var inventory = (Inventory)ViewBag.Inventory;
    var fields = (IReadOnlyList<InventoryField>)ViewBag.Fields;
}

<h1>Edit Item for @inventory.Title</h1>

@if (TempData["ItemEditError"] is string editError)
{
    <div class="alert alert-danger" role="alert">@editError</div>
}

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="InventoryId" />
    <input type="hidden" asp-for="RowVersion" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <div class="mb-3">
        <label asp-for="CustomId" class="form-label"></label>
        <input asp-for="CustomId" class="form-control" />
        <span asp-validation-for="CustomId" class="text-danger"></span>
    </div>

    @foreach (var field in fields)
    {
        var propertyName = GetPropertyName(field);
        var value = GetValue(propertyName);
        if (field.FieldType == InventoryFieldType.Boolean)
        {
            <div class="form-check mb-3">
                <input class="form-check-input" id="@propertyName" name="@propertyName" type="checkbox" value="true" checked="@((value is true) ? "checked" : null)" />
                <input name="@propertyName" type="hidden" value="false" />
                <label class="form-check-label" for="@propertyName">@field.Title</label>
                @if (!string.IsNullOrWhiteSpace(field.Description))
                {
                    <div class="form-text">@field.Description</div>
                }
            </div>
        }
        else if (field.FieldType == InventoryFieldType.Multiline)
        {
            <div class="mb-3">
                <label class="form-label" for="@propertyName">@field.Title</label>
                <textarea class="form-control" id="@propertyName" name="@propertyName" rows="3">@(value?.ToString() ?? string.Empty)</textarea>
                @if (!string.IsNullOrWhiteSpace(field.Description))
                {
                    <div class="form-text">@field.Description</div>
                }
            </div>
        }
        else
        {
            <div class="mb-3">
                <label class="form-label" for="@propertyName">@field.Title</label>
                <input class="form-control" id="@propertyName" name="@propertyName" type="@GetInputType(field)" value="@(value?.ToString() ?? string.Empty)" />
                @if (!string.IsNullOrWhiteSpace(field.Description))
                {
                    <div class="form-text">@field.Description</div>
                }
            </div>
        }
    }

    @if (!fields.Any())
    {
        <p class="text-muted">No custom fields configured.</p>
    }

    <button type="submit" class="btn btn-primary">Save</button>
    <a class="btn btn-link" asp-action="Index" asp-route-inventoryId="@inventory.Id">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@functions {
    private object? GetValue(string propertyName)
    {
        return propertyName switch
        {
            nameof(Model.Text1) => Model.Text1,
            nameof(Model.Text2) => Model.Text2,
            nameof(Model.Text3) => Model.Text3,
            nameof(Model.Multiline1) => Model.Multiline1,
            nameof(Model.Multiline2) => Model.Multiline2,
            nameof(Model.Multiline3) => Model.Multiline3,
            nameof(Model.Num1) => Model.Num1,
            nameof(Model.Num2) => Model.Num2,
            nameof(Model.Num3) => Model.Num3,
            nameof(Model.Doc1) => Model.Doc1,
            nameof(Model.Doc2) => Model.Doc2,
            nameof(Model.Doc3) => Model.Doc3,
            nameof(Model.Bool1) => Model.Bool1,
            nameof(Model.Bool2) => Model.Bool2,
            nameof(Model.Bool3) => Model.Bool3,
            _ => null
        };
    }

    private static string GetInputType(InventoryField field)
    {
        return field.FieldType == InventoryFieldType.Number ? "number" : "text";
    }

    private static string GetPropertyName(InventoryField field)
    {
        return field.FieldType switch
        {
            InventoryFieldType.Text => $"Text{field.SlotNumber}",
            InventoryFieldType.Multiline => $"Multiline{field.SlotNumber}",
            InventoryFieldType.Number => $"Num{field.SlotNumber}",
            InventoryFieldType.Document => $"Doc{field.SlotNumber}",
            InventoryFieldType.Boolean => $"Bool{field.SlotNumber}",
            _ => throw new ArgumentOutOfRangeException(nameof(field), field.FieldType, "Unsupported field type.")
        };
    }
}
